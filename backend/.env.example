# Copy to .env and fill in. Never commit the real .env.

GROQ_API_KEY=

# Optional: hosted embeddings via HuggingFace. Leave empty to use the local fastembed model.
HF_TOKEN=

# Database (Supabase connection details, or the local docker-compose database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres

# Auth — set whichever matches your Supabase project (see README). Not needed for guest mode.
SUPABASE_JWT_SECRET=
SUPABASE_URL=

FRONTEND_URL=http://localhost:5173
